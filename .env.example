# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# Base URL of your TestRail instance (no trailing slash)
TESTRAIL_URL=https://yourorg.testrail.io

# TestRail login e-mail
TESTRAIL_USER=your.email@example.com

# TestRail API key  (My Settings → API Keys)
TESTRAIL_API_KEY=your_api_key_here

# Numeric project id  (visible in the URL when you open the project)
TESTRAIL_PROJECT_ID=1

# Numeric suite id  (strip the leading "S", e.g. S2 → 2)
TESTRAIL_SUITE_ID=2
